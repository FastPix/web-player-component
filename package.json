{
  "name": "@fastpix/fp-player",
  "version": "1.0.22",
  "description": "FastPix Player SDK is a customizable video player for on-demand and live streaming.",
  "type": "module",
  "main": "./dist/player.js",
  "module": "./dist/player.esm.js",
  "types": "./dist/player.d.ts",
  "exports": {
    ".": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.esm.js",
      "require": "./dist/player.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "build": "npm run format && npm run typecheck && tsup",
    "prepublishOnly": "npm run build",
    "format:css": "prettier --write \"src/utils/innerHtml.ts\""
  },
  "keywords": [
    "FastPix Player",
    "HTML5 Video Player",
    "HLS Video Player",
    "Adaptive Streaming",
    "Customizable Video Player",
    "Live Streaming Player",
    "Shoppable Video Player",
    "DRM Player",
    "Chapters",
    "VOD Player",
    "Video Playback SDK",
    "Low-Latency Streaming",
    "M3U8 Player"
  ],
  "author": "FastPix, Inc",
  "license": "MIT",
  "dependencies": {
    "@fastpix/video-data-core": "^1.0.9"
  },
  "peerDependencies": {
    "hls.js": "^1.7.1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "hls.js": "^1.6.13",
    "prettier": "^3.3.3",
    "react": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
